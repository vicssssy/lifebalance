{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lifebalance",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lifebalance-db",
      "database_id": "922307ea-4247-4a4f-a17c-f9820bcc838c",
      "migrations_dir": "migrations",
    },
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
